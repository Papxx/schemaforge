{
  "schemaVersion": 1,
  "id": "schemaforge",
  "version": "${version}",
  "name": "SchemaForge",
  "description": "Prints Litematica schematics into the world: packet-paced printer, Baritone navigation between work clusters and material restock from known containers. A Meteor Client addon.",
  "authors": [
    "Papxx"
  ],
  "contact": {
    "homepage": "https://github.com/Papxx/schemaforge",
    "sources": "https://github.com/Papxx/schemaforge",
    "issues": "https://github.com/Papxx/schemaforge/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/schemaforge/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.tore.schemaforge.SchemaForgeAddon"
    ]
  },
  "mixins": [
    "schemaforge.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  },
  "suggests": {
    "litematica": "*",
    "malilib": "*",
    "baritone": "*",
    "baritone-meteor": "*"
  }
}
